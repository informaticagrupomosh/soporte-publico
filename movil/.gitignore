android/.idea/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/key.properties
*.jks
*.keystore
# Lo reescribe Flutter en cada compilación, igual que el de iOS.
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

